{
  "name": "BPMN Pilot",
  "prefix": "bpmnpilot",
  "uri": "https://bpmn.leylines.fr/schema/bpmn-pilot/1.0",
  "xml": { "tagAlias": "lowerCase" },
  "associations": [],
  "types": [
    {
      "name": "SimulationFlow",
      "extends": ["bpmn:SequenceFlow"],
      "properties": [
        { "name": "probability", "isAttr": true, "type": "Real" },
        { "name": "probabilitySource", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "AssignedActivity",
      "extends": ["bpmn:Activity"],
      "properties": [
        { "name": "assignee", "isAttr": true, "type": "String" },
        { "name": "systems", "isAttr": true, "type": "String" },
        { "name": "accountable", "isAttr": true, "type": "String" },
        { "name": "consulted", "isAttr": true, "type": "String" },
        { "name": "informed", "isAttr": true, "type": "String" },
        { "name": "aiPotential", "isAttr": true, "type": "String" },
        { "name": "aiPotentialReason", "isAttr": true, "type": "String" },
        { "name": "risks", "isAttr": true, "type": "String" },
        { "name": "controls", "isAttr": true, "type": "String" },
        { "name": "requirements", "isAttr": true, "type": "String" },
        { "name": "userStories", "isAttr": true, "type": "String" },
        { "name": "acceptanceCriteria", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "LinkedDiagram",
      "extends": ["bpmn:CallActivity"],
      "properties": [
        { "name": "linkedDiagram", "isAttr": true, "type": "String" },
        { "name": "linkedDiagramName", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "ProcessIdentity",
      "extends": ["bpmn:Process", "bpmn:Collaboration"],
      "properties": [
        { "name": "owner", "isAttr": true, "type": "String" },
        { "name": "version", "isAttr": true, "type": "String" },
        { "name": "status", "isAttr": true, "type": "String" },
        { "name": "validatedOn", "isAttr": true, "type": "String" },
        { "name": "scope", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "AgentStep",
      "extends": ["bpmn:AdHocSubProcess"],
      "properties": [
        { "name": "agent", "isAttr": true, "type": "Boolean" }
      ]
    },
    {
      "name": "Goal",
      "extends": ["bpmn:FlowNode"],
      "properties": [
        { "name": "goalShare", "isAttr": true, "type": "Real" },
        { "name": "goalOp", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "Analysis",
      "superClass": ["Element"],
      "meta": { "allowedIn": ["bpmn:Process", "bpmn:Collaboration"] },
      "properties": [
        { "name": "author", "isAttr": true, "type": "String" },
        { "name": "date", "isAttr": true, "type": "String" },
        { "name": "fingerprint", "isAttr": true, "type": "String" },
        { "name": "summary", "type": "AnalysisText" },
        { "name": "points", "type": "AnalysisPoint", "isMany": true }
      ]
    },
    {
      "name": "AnalysisText",
      "superClass": ["Element"],
      "properties": [
        { "name": "text", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "AnalysisPoint",
      "superClass": ["Element"],
      "properties": [
        { "name": "kind", "isAttr": true, "type": "String" },
        { "name": "elements", "isAttr": true, "type": "String" },
        { "name": "text", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "DecisionLink",
      "extends": ["bpmn:BusinessRuleTask"],
      "properties": [
        { "name": "decisionRef", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "TaskForm",
      "superClass": ["Element"],
      "meta": { "allowedIn": ["bpmn:UserTask", "bpmn:StartEvent"] },
      "properties": [
        { "name": "schema", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "DecisionModel",
      "superClass": ["Element"],
      "meta": { "allowedIn": ["bpmn:Process", "bpmn:Collaboration"] },
      "properties": [
        { "name": "xml", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "LogSummary",
      "superClass": ["Element"],
      "meta": { "allowedIn": ["bpmn:Process"] },
      "properties": [
        { "name": "source", "isAttr": true, "type": "String" },
        { "name": "date", "isAttr": true, "type": "String" },
        { "name": "fingerprint", "isAttr": true, "type": "String" },
        { "name": "data", "isBody": true, "type": "String" }
      ]
    }
  ]
}
