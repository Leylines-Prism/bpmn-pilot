<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Commande" name="Process an order" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Paiement" name="Check payment"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GPaiement" name="Payment accepted?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Stock" name="Check stock"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GStock" name="In stock?"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Fournisseur" name="Order from supplier"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GJoin"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Preparer" name="Prepare order"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Expedier" name="Ship"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Invoice" name="Invoice"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndOk" name="Order delivered"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Annuler" name="Cancel order"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndKo" name="Order cancelled"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Paiement"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Paiement" targetRef="GPaiement"/>
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="GPaiement" targetRef="Stock"/>
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="GPaiement" targetRef="Annuler"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Stock" targetRef="GStock"/>
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="GStock" targetRef="GJoin"/>
    <bpmn:sequenceFlow id="F7" name="no" sourceRef="GStock" targetRef="Fournisseur"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Fournisseur" targetRef="GJoin"/>
    <bpmn:sequenceFlow id="F9" sourceRef="GJoin" targetRef="Preparer"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Preparer" targetRef="Expedier"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Expedier" targetRef="Invoice"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Invoice" targetRef="EndOk"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Annuler" targetRef="EndKo"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D"><bpmndi:BPMNPlane id="P" bpmnElement="Commande">
    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="82" y="182" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="58" y="225" width="84" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Paiement_di" bpmnElement="Paiement"><dc:Bounds x="170" y="160" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="GPaiement_di" bpmnElement="GPaiement" isMarkerVisible="true"><dc:Bounds x="315" y="175" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="296" y="145" width="88" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Stock_di" bpmnElement="Stock"><dc:Bounds x="410" y="160" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="GStock_di" bpmnElement="GStock" isMarkerVisible="true"><dc:Bounds x="555" y="175" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="540" y="152" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Fournisseur_di" bpmnElement="Fournisseur"><dc:Bounds x="640" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="GJoin_di" bpmnElement="GJoin" isMarkerVisible="true"><dc:Bounds x="775" y="175" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Preparer_di" bpmnElement="Preparer"><dc:Bounds x="870" y="160" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Expedier_di" bpmnElement="Expedier"><dc:Bounds x="1020" y="160" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Invoice_di" bpmnElement="Invoice"><dc:Bounds x="1170" y="160" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="EndOk_di" bpmnElement="EndOk"><dc:Bounds x="1322" y="182" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1298" y="225" width="84" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Annuler_di" bpmnElement="Annuler"><dc:Bounds x="290" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="EndKo_di" bpmnElement="EndKo"><dc:Bounds x="442" y="312" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="414" y="355" width="92" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="118" y="200"/><di:waypoint x="170" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="270" y="200"/><di:waypoint x="315" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="365" y="200"/><di:waypoint x="410" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="374" y="182" width="18" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="340" y="225"/><di:waypoint x="340" y="290"/><bpmndi:BPMNLabel><dc:Bounds x="346" y="245" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="510" y="200"/><di:waypoint x="555" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="605" y="200"/><di:waypoint x="775" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="680" y="182" width="18" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="580" y="225"/><di:waypoint x="580" y="330"/><di:waypoint x="640" y="330"/><bpmndi:BPMNLabel><dc:Bounds x="586" y="260" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="740" y="330"/><di:waypoint x="800" y="330"/><di:waypoint x="800" y="225"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="825" y="200"/><di:waypoint x="870" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="970" y="200"/><di:waypoint x="1020" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1120" y="200"/><di:waypoint x="1170" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1270" y="200"/><di:waypoint x="1322" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="390" y="330"/><di:waypoint x="442" y="330"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
