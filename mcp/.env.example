# Modèle à copier en mcp/.env (exclu de git), puis à remplir.
# Ne jamais écrire de vraie clé API dans ce fichier-ci : il est publié.

# ── Anthropic ──────────────────────────────────────────────────────────
# Avec la clé seule, le menu propose Claude Opus 5.5, Sonnet 5.5 et Haiku 5.5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5=Claude Opus 5.5,claude-sonnet-5-5=Claude Sonnet 5.5,claude-haiku-5-5=Claude Haiku 5.5
# CHAT_EFFORT=medium

# ── Compatible OpenAI (OpenAI, OpenRouter, Ollama, LM Studio…) ─────────
# Actif dès que OPENAI_MODELS est rempli. Format : identifiant=Libellé, séparés par des virgules.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODELS=
# OPENAI_LABEL=Compatible OpenAI
# OPENAI_REASONING_EFFORT=

# ── Mistral ────────────────────────────────────────────────────────────
# Avec la clé seule, le menu propose Mistral Large et Mistral Small.
# Pour un traitement dans l'Union européenne (facturé 10 % de plus) :
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-large-latest=Mistral Large,mistral-small-latest=Mistral Small
# MISTRAL_REASONING_EFFORT=

# ── Choix par défaut dans le menu ──────────────────────────────────────
# CHAT_MODEL=anthropic:claude-opus-5-5

# ── Serveur ────────────────────────────────────────────────────────────
# MCP_PORT=3333
# Jeton demandé aux clients MCP (Authorization: Bearer …). Le bouton « Générer un jeton »
# de la fenêtre « Connecter un agent » (clic sur le badge MCP) en crée un.
# MCP_TOKEN=
# Sans jeton, /mcp est fermé (401) dès que MCP_ALLOWED_HOSTS contient un autre nom que localhost.
# off l'ouvre quand même : seulement sur un réseau de confiance, ou derrière un proxy qui
# authentifie /mcp.
# MCP_AUTH=
# Mode sans écran : on ouvre l'éditeur dans un Chromium sans écran quand aucun onglet n'est ouvert
# (voir docker-compose.headless.yml). Coupé par défaut.
# MCP_HEADLESS=off
# HEADLESS_BROWSER_URL=http://renderer:9222
# HEADLESS_EDITOR_URL=http://editor:8080
# HEADLESS_IDLE_SECONDS=300
# Clés API saisies dans le navigateur (fenêtre Options), relayées par le serveur.
# Vide : refusées dès qu'une clé ou un modèle est réglé ci-dessus. on : acceptées aussi. off : toujours refusées.
# BROWSER_KEYS=
# BPMN_EDITOR_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
